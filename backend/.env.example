PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/dentalbox
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d
CLIENT_URL=*

# Cloudinary Storage (Optional - falls back to local storage if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payment Gateway (Optional HMAC webhook / signature verification)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Live Broadcast SMS & WhatsApp Integration (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

MSG91_AUTH_KEY=
MSG91_SENDER_ID=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

